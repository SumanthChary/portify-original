# Environment Variables for Portify AI
# Copy this file to .env and fill in your actual values

# N8n Webhook URL for migration workflows
# Get this from your N8n dashboard after setting up the workflow
VITE_N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/migrate-gumroad"

# Payhip Credentials (for automation)
# Use test/sandbox accounts for development
PAYHIP_EMAIL="your-payhip-email@example.com"
PAYHIP_PASSWORD="your-payhip-password"

# Supabase Configuration
# Create a free Supabase project at https://supabase.com
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: Add other platform credentials as needed (e.g., Gumroad, Etsy)
# GUMROAD_ACCESS_TOKEN="your-gumroad-token"
# ETSY_API_KEY="your-etsy-key"